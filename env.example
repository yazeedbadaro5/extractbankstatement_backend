# Environment Configuration
ENVIRONMENT=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# Clerk Authentication
# Get these from your Clerk Dashboard: https://dashboard.clerk.com/
# Create a new Clerk application for each project
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Stripe Configuration
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/
# Create a new Stripe account or use existing one for each project
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Gemini Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Redis Configuration
# Default Redis connection URL (adjust if using remote Redis)
REDIS_URL=redis://localhost:6379

# Rate Limiting Configuration
# Maximum pages per day for free tier users
FREE_TIER_MAX_PAGES=1

# Azure Blob Storage Configuration
# Get these from your Azure Storage Account
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_STORAGE_ACCOUNT_KEY=your_storage_account_key

# Optional: Set to 'true' to enable debug logging
DEBUG=false
